<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>JatayuOS Project</vendor>
  <vendor_url>https://jatayuos.in</vendor_url>
  <action id="in.jatayuos.driverassistant.authorize-repair">
    <description>Authorize a Jatayu Driver Assistant repair session</description>
    <message>Administrator authentication is required to authorize a future driver repair session.</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>
</policyconfig>
